# Use the bundled offline package cache (see python/README_OFFLINE.md), so a
# plain `npm install` / `npm ci` works without internet. With a connection,
# anything missing from the cache is still fetched from the registry.
cache=../offline/npm-cache
prefer-offline=true
audit=false
fund=false
# Always install devDependencies (TypeScript, Vite, electron-builder are needed
# to build), even if NODE_ENV=production or omit=dev is set on the machine.
include=dev
# Create the node_modules/.bin launchers even if a global npmrc disables them.
bin-links=true
